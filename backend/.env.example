PORT=3000
DB_HOST=localhost
DB_NAME=shopai
DB_USER=root
DB_PASS=password
# Set to 'true' in dev to auto-create/update tables on boot (never in prod)
DB_SYNC=false
JWT_SECRET=supersecretjwt
JWT_REFRESH_SECRET=supersecretrefreshjwt
JWT_EXPIRES_IN=1h
# Optional: enables real AI (recommendations + product-sheet generation).
# Leave empty to use the deterministic fallback.
OPENAI_API_KEY=
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
NODE_ENV=development
